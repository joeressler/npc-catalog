# Local development defaults (DEBUG=true allows example credentials).
DEBUG=true
# Used for local (non-Docker) backend runs. Docker Compose overrides these to /data/...
SQLITE_PATH=db.sqlite3
MEDIA_ROOT=media
# Shared login credentials (passed into the backend container via compose env_file)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
AUTH_SECRET=dev-secret-change-me
# false for plain HTTP (localhost / port-forward). Set true only behind HTTPS.
AUTH_COOKIE_SECURE=false

# ComfyUI AI portraits/landscapes (Docker Compose sets these automatically).
# Leave disabled for split-dev unless you run ComfyUI locally.
# COMFYUI_ENABLED=true
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_TIMEOUT_SECONDS=180

# --- Production / port-forward (set these before exposing :31402) ---
# DEBUG=false
# AUTH_USERNAME=your-unique-username
# AUTH_PASSWORD=a-long-random-password
# AUTH_SECRET=a-long-random-signing-secret
# AUTH_COOKIE_SECURE=false   # keep false on plain HTTP; true only with TLS in front
